# Database connection string (defaults to backend/bhusuraksha.db if unset)
DATABASE_URL=sqlite:///./bhusuraksha.db

# Live weather provider. Currently only "open-meteo" is implemented — it is
# free and requires no API key. Left here so a future provider can be
# selected via configuration instead of code changes.
WEATHER_PROVIDER=open-meteo

# Optional real external datasets (see geospatial/config.py). None are
# required — the app works fully without any of these set.
# BHUSURAKSHA_LANDSLIDE_DATA_PATH=
# BHUSURAKSHA_RAINFALL_DATA_PATH=
# BHUSURAKSHA_DEM_DATA_PATH=
# BHUSURAKSHA_VEGETATION_DATA_PATH=

# Optional real India administrative boundaries (see geospatial/india/README.md).
# Not downloaded automatically; the app works fully without any of these.
# Real point-in-polygon state/district lookups only activate once configured.
# BHUSURAKSHA_INDIA_BOUNDARY_PATH=
# BHUSURAKSHA_STATE_BOUNDARY_PATH=
# BHUSURAKSHA_DISTRICT_BOUNDARY_PATH=

# Optional Phase 9 real-data ingestion connectors (see docs/REAL_DATA_INGESTION.md).
# None are required — ingestion always also supports a manual --path instead.
# BHUSURAKSHA_NASA_LANDSLIDE_URL=
# BHUSURAKSHA_IMD_RAINFALL_PATH=
# BHUSURAKSHA_DEM_PATH=
# BHUSURAKSHA_LANDCOVER_PATH=
