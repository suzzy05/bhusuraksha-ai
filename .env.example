# Used by docker-compose.yml only — local (non-Docker) development uses
# backend/.env and frontend/.env instead (see their own .env.example files).
#
# Copy this file to `.env` at the repo root before running:
#   docker compose up --build
# Never commit the real `.env` file.

POSTGRES_DB=bhusuraksha
POSTGRES_USER=bhusuraksha
# Set a real password — there is no default, docker-compose.yml refuses to
# start the db service without one.
POSTGRES_PASSWORD=

# Optional overrides (sane defaults are baked into docker-compose.yml)
# WEATHER_PROVIDER=open-meteo
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# LOG_LEVEL=INFO
